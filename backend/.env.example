# Backend Environment Configuration
PROJECT_NAME="MyMail"
API_V1_STR="/api"
JWT_SECRET="generate-a-secure-random-32-byte-hex-string-for-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Supabase (optional, for cloud sync)
SUPABASE_URL=""
SUPABASE_KEY=""
DATABASE_URL=""

# GitHub OAuth
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_REDIRECT_URI="http://localhost:5173/auth/callback/github"

# Google OAuth 2.0 (Gmail API)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:5173/auth/callback/google"

# Microsoft OAuth 2.0 (Outlook / Graph API - Modular Architecture)
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_REDIRECT_URI="http://localhost:5173/auth/callback/outlook"
